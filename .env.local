# Local Development Configuration
NEXTAUTH_SECRET=development_veritas_secret_key_minimum_32_characters_long_for_jwt
NEXTAUTH_URL=http://localhost:3000

# To enable real Google Sign In, replace these with your Google Cloud OAuth Client ID & Secret:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# To enable real Gemini 1.5 Flash AI Detection, get a free key from https://aistudio.google.com/:
GEMINI_API_KEY=
